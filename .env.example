# Copy this file to .env and set real values. The real .env is never committed (Constitution, Article IX).
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5433

# API (plan.md §2): long random JWT_SECRET; the admin is created at startup from these values (D-10)
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
API_HOST_PORT=8000
CORS_ORIGIN=http://localhost:5173
APP_HOST_PORT=5173
